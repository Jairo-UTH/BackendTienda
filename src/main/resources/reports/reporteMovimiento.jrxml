<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="reporteMovimiento" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="productoNombre" class="java.lang.String"/>

    <field name="fecha" class="java.lang.String"/>
    <field name="tipoMovimiento" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio" class="java.math.BigDecimal"/>
    <field name="empleado" class="java.lang.String"/>

    <title>
        <band height="45">
            <staticText><reportElement x="0" y="0" width="535" height="28"/><textElement><font size="16" isBold="true"/></textElement><text><![CDATA[Reporte de Movimiento por Producto]]></text></staticText>
            <textField>
                <reportElement x="0" y="28" width="535" height="16"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Producto: " + $P{productoNombre}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="100" height="20"/><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="100" y="0" width="90" height="20"/><text><![CDATA[Tipo]]></text></staticText>
            <staticText><reportElement x="190" y="0" width="80" height="20"/><text><![CDATA[Cantidad]]></text></staticText>
            <staticText><reportElement x="270" y="0" width="100" height="20"/><text><![CDATA[Precio]]></text></staticText>
            <staticText><reportElement x="370" y="0" width="165" height="20"/><text><![CDATA[Empleado]]></text></staticText>
            <line><reportElement x="0" y="19" width="535" height="1"/></line>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField><reportElement x="0" y="0" width="100" height="16"/><textFieldExpression class="java.lang.String"><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField><reportElement x="100" y="0" width="90" height="16"/><textFieldExpression class="java.lang.String"><![CDATA[$F{tipoMovimiento}]]></textFieldExpression></textField>
            <textField><reportElement x="190" y="0" width="80" height="16"/><textFieldExpression class="java.lang.Integer"><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="270" y="0" width="100" height="16"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{precio}]]></textFieldExpression></textField>
            <textField><reportElement x="370" y="0" width="165" height="16"/><textFieldExpression class="java.lang.String"><![CDATA[$F{empleado}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>