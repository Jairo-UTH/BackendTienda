<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="reporteVentasPorDia" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <field name="fecha" class="java.lang.String"/>
    <field name="cantidadFacturas" class="java.lang.Integer"/>
    <field name="totalVentas" class="java.math.BigDecimal"/>
    <field name="totalImpuesto" class="java.math.BigDecimal"/>

    <title>
        <band height="30">
            <staticText><reportElement x="0" y="0" width="535" height="28"/><textElement><font size="16" isBold="true"/></textElement><text><![CDATA[Reporte de Ventas por Día]]></text></staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="120" height="20"/><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="120" y="0" width="120" height="20"/><text><![CDATA[Facturas]]></text></staticText>
            <staticText><reportElement x="240" y="0" width="140" height="20"/><text><![CDATA[Total ventas]]></text></staticText>
            <staticText><reportElement x="380" y="0" width="140" height="20"/><text><![CDATA[Total impuesto]]></text></staticText>
            <line><reportElement x="0" y="19" width="535" height="1"/></line>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="120" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="120" height="18"/><textFieldExpression class="java.lang.Integer"><![CDATA[$F{cantidadFacturas}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="240" y="0" width="140" height="18"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{totalVentas}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="380" y="0" width="140" height="18"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{totalImpuesto}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>